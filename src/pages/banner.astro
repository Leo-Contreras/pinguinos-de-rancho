---
import Layout from '../layouts/Layout.astro';
import { team } from '../data/team';
// Dirección que aparece en el banner. Cámbiala cuando tengas dominio propio.
const site = 'Hielo en el rancho, fuego en la grieta';
---
<Layout title={`Haz tu banner | ${team.name}`} description="Sube tu foto, escribe tu nombre y descarga tu banner de Pingüinos de Rancho.">
  <header class="nav">
    <a class="brand" href="/"><img src="/logo.png" alt="" width="40" height="40" /><span>{team.name}</span></a>
    <a class="back" href="/">← Volver al inicio</a>
  </header>

  <main class="section">
    <div class="head">
      <h2>Haz tu banner</h2>
      <p>Sube tu foto, escribe tu nombre y descarga tu banner de la manada. Tu foto no se sube a ningún servidor: todo pasa en tu navegador.</p>
    </div>

    <div class="gen">
      <form class="panel" onsubmit="return false">
        <label>Tu nombre
          <input id="name" maxlength="24" value="Tu nombre" autocomplete="off" />
        </label>
        <label>Rol
          <select id="role">
            <option>Jugador</option>
            <option>Staff</option>
            <option>Fan</option>
          </select>
        </label>
        <label>Formato
          <select id="fmt">
            <option value="x">Banner para X / Twitter (1500×500)</option>
            <option value="discord">Banner de Discord (960×540)</option>
            <option value="square">Post cuadrado (1080×1080)</option>
            <option value="story">Historia vertical (1080×1920)</option>
          </select>
        </label>
        <label class="drop" id="drop">
          <input id="file" type="file" accept="image/*" hidden />
          <span id="dropText">Toca o arrastra tu foto aquí</span>
        </label>
        <label>Zoom <input id="zoom" type="range" min="1" max="3" step="0.05" value="1" /></label>
        <label>Posición horizontal <input id="px" type="range" min="-100" max="100" value="0" /></label>
        <label>Posición vertical <input id="py" type="range" min="-100" max="100" value="0" /></label>
        <button class="btn dl" type="button" id="download">Descargar PNG</button>
      </form>

      <canvas id="cv" width="1500" height="500" data-site={site} aria-label="Vista previa de tu banner"></canvas>
    </div>
  </main>

  <script>
    const FORMATS = { x: [1500, 500], discord: [960, 540], square: [1080, 1080], story: [1080, 1920] };
    const el = (id) => document.getElementById(id);
    const canvas = el('cv');
    const ctx = canvas.getContext('2d');
    const SITE = canvas.dataset.site || '';
    const FONT = '"Big Shoulders Display", "Arial Narrow", sans-serif';
    const logo = new Image();
    logo.src = '/logo-transparent.png';
    let photo = null;

    function setFont(size, weight, ls) {
      ctx.font = weight + ' ' + size + 'px ' + FONT;
      if ('letterSpacing' in ctx) ctx.letterSpacing = (ls * size) + 'px';
    }
    function fit(text, maxW, size, weight, ls) {
      setFont(size, weight, ls);
      while (ctx.measureText(text).width > maxW && size > 16) { size -= 4; setFont(size, weight, ls); }
      return size;
    }

    function draw() {
      const [W, H] = FORMATS[el('fmt').value];
      canvas.width = W; canvas.height = H;
      const name = (el('name').value.trim() || 'TU NOMBRE').toUpperCase();
      const sub = '#PINGÜINOSDERANCHO · ' + el('role').value.toUpperCase();
      const wide = W / H > 1.4;
      const square = !wide && H / W < 1.3;

      // Fondo
      const bg = ctx.createLinearGradient(0, 0, W, H);
      bg.addColorStop(0, '#021428'); bg.addColorStop(1, '#0b3158');
      ctx.fillStyle = bg; ctx.fillRect(0, 0, W, H);
      const gx = W * (wide ? 0.2 : 0.5), gy = H * (wide ? 0.5 : 0.3);
      const glow = ctx.createRadialGradient(gx, gy, 0, gx, gy, Math.max(W, H) * 0.6);
      glow.addColorStop(0, 'rgba(29,155,216,.38)'); glow.addColorStop(1, 'rgba(29,155,216,0)');
      ctx.fillStyle = glow; ctx.fillRect(0, 0, W, H);
      ctx.save();
      ctx.translate(W / 2, H / 2); ctx.rotate(-Math.PI / 5.5);
      const diag = Math.hypot(W, H), sw = diag * 0.06;
      ctx.fillStyle = 'rgba(127,214,255,.05)';
      for (let i = -15; i <= 15; i++) ctx.fillRect(i * sw * 2, -diag, sw, diag * 2);
      ctx.restore();

      // Disposición
      let r, cx, cy, tx, align;
      if (wide) { r = H * 0.33; cx = H * 0.17 + r; cy = H / 2; tx = cx + r + H * 0.14; align = 'left'; }
      else { r = W * 0.26; cx = W / 2; cy = H * (square ? 0.34 : 0.3); tx = W / 2; align = 'center'; }

      // Foto en círculo con aro de hielo
      ctx.save();
      ctx.shadowColor = 'rgba(127,214,255,.6)'; ctx.shadowBlur = r * 0.15;
      ctx.beginPath(); ctx.arc(cx, cy, r * 1.045, 0, Math.PI * 2);
      ctx.fillStyle = '#7fd6ff'; ctx.fill();
      ctx.restore();
      ctx.save();
      ctx.beginPath(); ctx.arc(cx, cy, r, 0, Math.PI * 2); ctx.clip();
      ctx.fillStyle = '#0a2b50'; ctx.fillRect(cx - r, cy - r, r * 2, r * 2);
      if (photo) {
        const iw = photo.naturalWidth, ih = photo.naturalHeight;
        const sc = Math.max(2 * r / iw, 2 * r / ih) * parseFloat(el('zoom').value);
        const dw = iw * sc, dh = ih * sc;
        const px = parseFloat(el('px').value) / 100, py = parseFloat(el('py').value) / 100;
        ctx.drawImage(photo, cx - dw / 2 + px * (dw - 2 * r) / 2, cy - dh / 2 + py * (dh - 2 * r) / 2, dw, dh);
      } else if (logo.naturalWidth) {
        const s = r * 1.5;
        ctx.drawImage(logo, cx - s / 2, cy - (s * logo.naturalHeight / logo.naturalWidth) / 2, s, s * logo.naturalHeight / logo.naturalWidth);
      }
      ctx.restore();

      // Textos
      const margin = wide ? H * 0.07 : W * 0.05;
      const maxW = wide ? W - tx - H * 0.08 : W * 0.86;
      const nsize = fit(name, maxW, wide ? H * 0.34 : W * 0.15, 900, 0.01);
      const ssize = fit(sub, maxW, wide ? H * 0.085 : W * 0.045, 800, 0.06);
      const gap = nsize * 0.28;
      let nameBase;
      if (wide) { const total = nsize * 0.75 + gap + ssize * 0.75; nameBase = cy - total / 2 + nsize * 0.75; }
      else { nameBase = cy + r + W * 0.09 + nsize * 0.75; }
      const subBase = nameBase + gap + ssize * 0.75;

      ctx.textAlign = align; ctx.textBaseline = 'alphabetic';
      setFont(nsize, 900, 0.01);
      ctx.save();
      ctx.shadowColor = '#1d9bd8'; ctx.shadowOffsetY = nsize * 0.03;
      ctx.fillStyle = '#eaf6ff'; ctx.fillText(name, tx, nameBase);
      ctx.restore();
      setFont(ssize, 800, 0.06);
      ctx.fillStyle = '#7fd6ff'; ctx.fillText(sub, tx, subBase);

      // Acento naranja
      const bw = wide ? H * 0.2 : W * 0.18, bh = ssize * 0.2, bx = wide ? tx : tx - bw / 2, by = subBase + ssize * 0.55, sk = bh;
      ctx.fillStyle = '#f5a623';
      ctx.beginPath(); ctx.moveTo(bx + sk, by); ctx.lineTo(bx + bw, by); ctx.lineTo(bx + bw - sk, by + bh); ctx.lineTo(bx, by + bh); ctx.closePath(); ctx.fill();

      // Logo y sitio web
      const L = wide ? H * 0.3 : (square ? W * 0.15 : W * 0.34);
      const Lh = logo.naturalWidth ? L * logo.naturalHeight / logo.naturalWidth : L;
      let lx, ly, ux, uy, ua;
      if (wide) { lx = W - margin - L; ly = H - margin - Lh; ux = tx; uy = H - margin; ua = 'left'; }
      else if (square) { lx = W - margin - L; ly = H - margin - Lh; ux = margin; uy = H - margin; ua = 'left'; }
      else { lx = (W - L) / 2; ly = H * 0.78; ux = W / 2; uy = ly + Lh + H * 0.04; ua = 'center'; }
      if (logo.naturalWidth) ctx.drawImage(logo, lx, ly, L, Lh);
      if (SITE) {
        setFont(wide ? H * 0.055 : W * 0.032, 700, 0.04);
        ctx.textAlign = ua; ctx.fillStyle = 'rgba(234,246,255,.55)';
        ctx.fillText(SITE.toUpperCase(), ux, uy);
      }
      if ('letterSpacing' in ctx) ctx.letterSpacing = '0px';
    }

    function loadFile(f) {
      if (!f || !f.type.startsWith('image/')) return;
      const url = URL.createObjectURL(f);
      const img = new Image();
      img.onload = () => { photo = img; el('dropText').textContent = f.name; draw(); };
      img.src = url;
    }

    ['name', 'role', 'fmt', 'zoom', 'px', 'py'].forEach((id) => el(id).addEventListener('input', draw));
    el('file').addEventListener('change', (e) => loadFile(e.target.files[0]));
    const drop = el('drop');
    drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.classList.add('over'); });
    drop.addEventListener('dragleave', () => drop.classList.remove('over'));
    drop.addEventListener('drop', (e) => { e.preventDefault(); drop.classList.remove('over'); loadFile(e.dataTransfer.files[0]); });

    el('download').addEventListener('click', () => {
      draw();
      canvas.toBlob((blob) => {
        const a = document.createElement('a');
        const slug = (el('name').value.trim() || 'banner').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'banner';
        a.href = URL.createObjectURL(blob);
        a.download = 'pdr-' + slug + '-' + el('fmt').value + '.png';
        a.click();
        setTimeout(() => URL.revokeObjectURL(a.href), 2000);
      }, 'image/png');
    });

    logo.onload = draw;
    draw();
    document.fonts.load('900 100px "Big Shoulders Display"').then(draw);
    document.fonts.load('800 100px "Big Shoulders Display"').then(draw);
  </script>
</Layout>

<style is:global>

.back { color: var(--abismo); background: var(--hielo); padding: .45rem 1.1rem; font-weight: 600; text-decoration: none; clip-path: polygon(8px 0, 100% 0, calc(100% - 8px) 100%, 0 100%); }
.back:hover { background: var(--nieve); }
.gen { display: grid; grid-template-columns: minmax(280px, 380px) 1fr; gap: 2rem; max-width: 1280px; margin-inline: auto; align-items: start; }
.panel select { display: block; width: 100%; margin-top: .3rem; padding: .65rem .8rem; background: var(--noche); border: 1px solid #2a62a0; color: var(--nieve); font: inherit; }
.panel input[type="range"] { padding: 0; accent-color: var(--estrella); }
.drop { border: 2px dashed #2a62a0; padding: 1.2rem; text-align: center; color: var(--niebla); cursor: pointer; word-break: break-all; }
.drop:hover, .drop.over { border-color: var(--hielo); color: var(--nieve); }
.dl { border: 0; cursor: pointer; width: 100%; }
#cv { display: block; width: auto; height: auto; max-width: 100%; max-height: 78vh; margin-inline: auto; border: 1px solid #1a4573; }
@media (max-width: 860px) { .gen { grid-template-columns: 1fr; } }
</style>